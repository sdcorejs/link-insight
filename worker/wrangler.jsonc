{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sdcorejs-link-insight",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "observability": {
    "enabled": false,
  },
  "vars": {
    "PUBLIC_WORKER_ORIGIN": "https://link-insight.invalid",
    "ALLOWED_EXTENSION_IDS": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "SESSION_IDLE_TTL_SECONDS": "2592000",
    "OAUTH_STATE_TTL_SECONDS": "600",
    "EXCHANGE_CODE_TTL_SECONDS": "300",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sdcorejs-link-insight-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
